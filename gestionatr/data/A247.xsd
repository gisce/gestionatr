<?xml version="1.0" encoding="ISO-8859-1"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://localhost/sctd/A247"
	xmlns:tns="http://localhost/sctd/A247"
	elementFormDefault="qualified" >

	<include schemaLocation="CommonTagsATCOM.xsd"></include>
	<complexType name="HeadingA247Type">
		<sequence>
			<element name="dispatchingcode" maxOccurs="1"
				minOccurs="1">
				<simpleType>
					<restriction base="string">
						<enumeration value="GML"></enumeration>
						<length value="3"></length>
					</restriction>
				</simpleType>
			</element>
			<element name="dispatchingcompany" type="tns:AgenteType"
				maxOccurs="1" minOccurs="1">
			</element>
			<element name="destinycompany" type="tns:AgenteType"
				maxOccurs="1" minOccurs="1">
			</element>
			<element name="communicationsdate" type="date" maxOccurs="1"
				minOccurs="1">
			</element>
			<element name="communicationshour" type="time" maxOccurs="1"
				minOccurs="1">
			</element>
			<element name="processcode" maxOccurs="1" minOccurs="1">
				<simpleType>
					<restriction base="string">
						<length value="2"></length>
						<enumeration value="47"></enumeration>
					</restriction>
				</simpleType>
			</element>
			<element name="messagetype" maxOccurs="1" minOccurs="1">
				<simpleType>
					<restriction base="string">
						<enumeration value="A2"></enumeration>
						<minLength value="1"></minLength>
						<maxLength value="3"></maxLength>
					</restriction>
				</simpleType>
			</element>
		</sequence>
	</complexType>


	<element name="sctdapplication"
		type="tns:SctdApplicationA247Type">
	</element>

	<complexType name="SctdApplicationA247Type">
		<sequence>
			<element name="heading" type="tns:HeadingA247Type"
				maxOccurs="1" minOccurs="1">
			</element>
			<element name="a2" type="tns:A247Type" maxOccurs="unbounded"
				minOccurs="1">
			</element>
		</sequence>
	</complexType>

	<complexType name="A247Type">
		<sequence>
			<element name="reqcode" type="tns:ReqcodeType" maxOccurs="1"
				minOccurs="0">
				<annotation>
					<documentation>Código Solicitud</documentation>
				</annotation>
			</element>
			<element name="responsedate" type="date" maxOccurs="1"
				minOccurs="1">
				<annotation>
					<documentation>Fecha Respuesta</documentation>
				</annotation>
			</element>
			<element name="responsehour" type="time" maxOccurs="1"
				minOccurs="1">
				<annotation>
					<documentation>Hora Respuesta</documentation>
				</annotation>
			</element>
			<element name="comreferencenum"
				type="tns:ComreferencenumType" maxOccurs="1" minOccurs="1">
				<annotation>
					<documentation>
						Nº Referencia Solicitud Comercializadora
					</documentation>
				</annotation>
			</element>
			<element name="annulmentreason" type="tns:MotivoAnulacionType" minOccurs="1" maxOccurs="1">
				<annotation>
					<documentation>Motivo de Anulación</documentation>
				</annotation>
			</element>
			<element name="operationtype" type="tns:OperationType"
				maxOccurs="1" minOccurs="0">
				<annotation>
					<documentation>Tipo de Actuación</documentation>
				</annotation>
			</element>
			<element name="cups" type="tns:CupsType" maxOccurs="1"
				minOccurs="0">
				<annotation>
					<documentation>CUPS</documentation>
				</annotation>
			</element>
			<element name="claimtype" type="tns:ClaimType" minOccurs="0" maxOccurs="1">
				<annotation>
					<documentation>Tipo de Reclamación</documentation>
				</annotation>
			</element>
			<element name="claimsubtype" type="tns:ClaimSubtype" minOccurs="0" maxOccurs="1">
				<annotation>
					<documentation>Subtipo de Reclamación</documentation>
				</annotation>
			</element>
			<element name="reqcodetoanul" type="tns:ReqcodeType"
				maxOccurs="1" minOccurs="0">
				<annotation>
					<documentation>
						Código de Solicitud de SCTD a Anular
					</documentation>
				</annotation>
			</element>
			<element name="result" type="tns:ResultadoA2Type"
				maxOccurs="1" minOccurs="1">
				<annotation>
					<documentation>Código de Resultado</documentation>
				</annotation>
			</element>
			<element name="resultdesc" type="tns:ResultdescType"
				maxOccurs="1" minOccurs="1">
				<annotation>
					<documentation>
						Descripción de Resultado
					</documentation>
				</annotation>
			</element>
			<element name="resultreason" maxOccurs="1" minOccurs="0"
				type="tns:MotivoRechazoType">
				<annotation>
					<documentation>
						Código Motivo Resultado
					</documentation>
				</annotation>
			</element>
			<element name="resultreasondesc" maxOccurs="1" minOccurs="0"
				type="tns:ResultreasondescType">
				<annotation>
					<documentation>
						Descripción del Motivo Resultado
					</documentation>
				</annotation>
			</element>
			<element name="extrainfo" type="tns:ExtrainfoType"
				maxOccurs="1" minOccurs="0">
				<annotation>
					<documentation>
						Observaciones de la Respuesta
					</documentation>
				</annotation>
			</element>
		</sequence>
	</complexType>

</schema>